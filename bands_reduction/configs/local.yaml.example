# Copiar a configs/local.yaml (gitignored) y ajustar rutas de la máquina.
# Se fusiona sobre global.yaml al correr los scripts.

paths:
  mosaics_dir: /path/to/mosaic_184bands_mask_water/2015
  mosaic_layout: cim_flat
  mosaic_filename_template: "{tile}-{year}-L8-3-184F-HARM_masked.tif"
  ecoregions: /path/to/ecorregiones_col3_30m_alineado_lulc.tif
  results_dir: results/CIM2015
